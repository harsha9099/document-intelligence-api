{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LlmSettings": {
    "DefaultProvider": "anthropic",
    "AnthropicApiKey": "",
    "OpenAiApiKey": ""
  },
  "DocumentSettings": {
    "AllowedExtensions": "pdf,png,jpg,jpeg,tiff,bmp,webp",
    "MaxFileSizeMb": 50
  },
  "Persistence": {
    "Backend": "sqlite"
  },
  "Storage": {
    "Backend": "local",
    "Path": "./uploads"
  },
  "ConnectionStrings": {
    "Documents": "Data Source=documents.db"
  }
}
