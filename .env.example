# Leave all keys blank to auto-use the mock provider (no real API calls, instant responses)
# Set DEFAULT_LLM_PROVIDER=mock to force it explicitly

# Direct Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEFAULT_LLM_PROVIDER=anthropic
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,bmp,webp

# Persistence backend: sqlite (default), memory, cosmos, sql, table_storage
PERSISTENCE_BACKEND=sqlite
DATABASE_URL=documents.db

# File storage backend: local (default), azure_blob
STORAGE_BACKEND=local
STORAGE_PATH=./uploads

# Aitrium Gateway (use DEFAULT_LLM_PROVIDER=aitrium to enable)
AITRIUM_BASE_URL=https://your-gateway-url/v1/claude
AITRIUM_AUTH_TOKEN=your-base64-token-here
AITRIUM_MODEL=your-model-id-or-arn

# AWS Bedrock direct (use DEFAULT_LLM_PROVIDER=bedrock to enable)
BEDROCK_REGION=eu-central-1
BEDROCK_MODEL=anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_ENDPOINT=
BEDROCK_ACCESS_KEY=
BEDROCK_SECRET_KEY=
BEDROCK_SESSION_TOKEN=

# Extraction strategy:
#   adaptive (default) — smart routing: quality detection + Azure DI + field completeness, LLM as fallback
#   llm_only           — always use LLM (safest, most expensive)
#   ocr_first          — try OCR text extraction first, LLM fallback
#   azure_di_first     — try Azure DI first, LLM fallback (no quality detection)
#   hybrid             — run both Azure DI and LLM, merge and compare
EXTRACTION_STRATEGY=adaptive
CONFIDENCE_THRESHOLD=0.85

# Azure Document Intelligence (required for adaptive/azure_di_first/hybrid strategies)
# Without this, adaptive will fall back to LLM automatically
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DI_KEY=your-key-here
